"""Probe: min_by[T] returning Tuple[i32, T] and calling safe_get[T].
Hammers: tuple-return from generic + transitive generic-in-generic
+ multiple instantiations on the same call path (safe_get instantiated
for T but also implicitly for f64 via priority).
"""

fn safe_get[T](xs: List[T], i: i32, default: T) -> T:
    try:
        return xs[i]
    except IndexError as e:
        return default

fn min_by[T](xs: List[T], priority: List[f64], sentinel: T) -> Tuple[i32, T]:
    n: i32 = i32(i64(len(xs)))
    if n == 0:
        return (-1, sentinel)
    best_idx: i32 = 0
    best_p: f64 = priority[0]
    i: i32 = 1
    while i < n:
        if priority[i] < best_p:
            best_p = priority[i]
            best_idx = i
        i = i + 1
    # Stress safe_get__T inside min_by__T (transitive instantiation).
    return (best_idx, safe_get(xs, best_idx, sentinel))

fn main() -> i32:
    xs_i32: List[i32] = [10, 20, 30, 40]
    pri: List[f64] = [4.0, 1.0, 9.0, 2.0]
    r1: Tuple[i32, i32] = min_by(xs_i32, pri, -1)
    println(str(r1))            # (1, 20)

    xs_str: List[str] = ["a", "b", "c"]
    pri2: List[f64] = [3.0, 1.0, 2.0]
    r2: Tuple[i32, str] = min_by(xs_str, pri2, "?")
    println(str(r2))            # (1, b)
    return 0
