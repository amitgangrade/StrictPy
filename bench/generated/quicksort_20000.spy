fn partition(a: List[i64], lo: i64, hi: i64) -> i64:
    pivot: i64 = a[hi]
    i: i64 = lo - 1
    j: i64 = lo
    while j < hi:
        if a[j] <= pivot:
            i = i + 1
            tmp: i64 = a[i]
            a[i] = a[j]
            a[j] = tmp
        j = j + 1
    tmp2: i64 = a[i + 1]
    a[i + 1] = a[hi]
    a[hi] = tmp2
    return i + 1

fn quicksort(a: List[i64], lo: i64, hi: i64) -> None:
    if lo < hi:
        p: i64 = partition(a, lo, hi)
        quicksort(a, lo, p - 1)
        quicksort(a, p + 1, hi)

fn build(n: i64) -> List[i64]:
    a: List[i64] = []
    i: i64 = 0
    while i < n:
        a.append(n - i)
        i = i + 1
    return a

fn main() -> i32:
    a: List[i64] = build(20000)
    quicksort(a, 0, 20000 - 1)
    println("first=" + str(a[0]) + " last=" + str(a[20000 - 1]))
    return 0
