"""enum_demo.spy — LANE E `enum` named-constant facility (spec §9.x).

StrictPy's static model has no class-with-attributes Enum, so `enum`
ships as a registry: make a namespace, register members (name -> i64
value), then look up in either direction.  This is the IntEnum shape —
each member maps to an integer.

Tests:
  * compiler/tests/enum_demo_runs.rs — subprocess assertion.
"""

import enum

fn main() -> i32:
    color: i64 = enum.new()
    enum.add(color, "RED", 0i64)
    enum.add(color, "GREEN", 1i64)
    enum.add(color, "BLUE", 2i64)

    println("len=" + str(enum.len(color)))            # 3
    println("GREEN=" + str(enum.value_of(color, "GREEN")))   # 1
    println("name_of_2=" + enum.name_of(color, 2i64))        # BLUE
    println("has_RED=" + str(enum.has_name(color, "RED")))   # true
    println("has_PINK=" + str(enum.has_name(color, "PINK"))) # false

    # A second, independent enum — handles don't collide.
    status: i64 = enum.new()
    enum.add(status, "OK", 200i64)
    enum.add(status, "NOT_FOUND", 404i64)
    println("OK=" + str(enum.value_of(status, "OK")))        # 200
    println("name_of_404=" + enum.name_of(status, 404i64))   # NOT_FOUND
    println("status_len=" + str(enum.len(status)))           # 2

    return 0
