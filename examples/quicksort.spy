"""Quicksort over List[i64]. Tests in-place mutation via indexed assignment
(`a[i] = x`), recursion with multiple integer params, and comparison."""

fn partition(a: List[i64], lo: i64, hi: i64) -> i64:
    pivot: i64 = a[hi]
    i: i64 = lo - 1
    j: i64 = lo
    while j < hi:
        if a[j] <= pivot:
            i = i + 1
            tmp: i64 = a[i]
            a[i] = a[j]
            a[j] = tmp
        j = j + 1
    tmp2: i64 = a[i + 1]
    a[i + 1] = a[hi]
    a[hi] = tmp2
    return i + 1

fn quicksort(a: List[i64], lo: i64, hi: i64) -> None:
    if lo < hi:
        p: i64 = partition(a, lo, hi)
        quicksort(a, lo, p - 1)
        quicksort(a, p + 1, hi)

fn main() -> i32:
    a: List[i64] = [5, 2, 8, 1, 9, 3, 7, 4, 6, 0]
    quicksort(a, 0, 9)
    i: i64 = 0
    while i < 10:
        println("a[" + str(i) + "] = " + str(a[i]))
        i = i + 1
    return 0
