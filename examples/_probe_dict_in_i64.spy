"""_probe_dict_in_i64.spy — segfault repro.

`<i64> in Dict[i64, i64]` crashes the VM (segfault on Linux).
"""


fn main() -> i32:
    di: Dict[i64, i64] = {}
    di[1i64] = 10i64
    di[2i64] = 20i64
    # This line segfaults.
    if 1i64 in di:
        println("present")
    else:
        println("absent")
    return 0
