"""tabular_serve_demo.spy — walkthrough of `tabular.serve` (M50a + M50b + M50c).

Builds a small DataFrame in memory, then boots a localhost HTTP/1.1
server exposing it as a JSON API + a minimal bundled HTML/JS frontend.

Surface demonstrated:

  1. DataFrame construction (col_* + from_columns) including a
     ColumnCategorical column (M50b serializes these as their
     resolved category strings; M50a rendered them as null).
  2. tabular.serve_with_timeout(df, port, timeout_ms) — boots the
     localhost server and shuts it down after the timeout.
  3. The bundled HTML+JS frontend at GET /, plus the JSON API at
     /api/schema, /api/rows (with M50c index data), /api/cell,
     /api/filter (POST), /api/groupby (POST, with optional
     `"sort":true` per M50c), and the M50b additions: /api/sort,
     /api/filter_multi, /api/csv, /api/forget; plus the M50c
     additions: /api/pivot.
  4. M50c bundled chart panel (canvas-based bar/line/histogram) and
     pivot panel (index/columns/values/aggfunc selectors).

This demo uses serve_with_timeout so it exits cleanly after a short
interval — that lets the test harness (`compiler/tests/
tabular_serve_demo_runs.rs`) run it deterministically.

To use the server interactively, change `timeout_ms` below to a
larger value (e.g. 600000 = 10 minutes) and open
http://127.0.0.1:8765/ in a browser.  Try: click a column header to
sort, use the Pivot panel with index=dept/columns=active/values=score/
aggfunc=mean, then click Render in the Chart panel after picking
bar + an X/Y combo.
"""

from tabular import Column, ColumnI64, ColumnStr, ColumnF64, ColumnBool, ColumnCategorical, DataFrame
import tabular


fn build_employees() -> DataFrame:
    """Construct a 6-row DataFrame with id/name/score/active/dept columns.

    `dept` is a ColumnCategorical so the M50b categorical-cell
    serialization shows up in the bundled HTML frontend.
    """
    ids_v: List[i64] = []
    ids_v.append(1i64)
    ids_v.append(2i64)
    ids_v.append(3i64)
    ids_v.append(4i64)
    ids_v.append(5i64)
    ids_v.append(6i64)
    names_v: List[str] = []
    names_v.append("alice")
    names_v.append("bob")
    names_v.append("carol")
    names_v.append("dave")
    names_v.append("eve")
    names_v.append("frank")
    scores_v: List[f64] = []
    scores_v.append(95.5)
    scores_v.append(82.0)
    scores_v.append(78.25)
    scores_v.append(90.0)
    scores_v.append(88.5)
    scores_v.append(72.75)
    active_v: List[bool] = []
    active_v.append(true)
    active_v.append(false)
    active_v.append(true)
    active_v.append(true)
    active_v.append(true)
    active_v.append(false)
    depts_v: List[str] = []
    depts_v.append("eng")
    depts_v.append("eng")
    depts_v.append("sales")
    depts_v.append("eng")
    depts_v.append("sales")
    depts_v.append("ops")
    nulls: List[bool] = []
    nulls.append(false)
    nulls.append(false)
    nulls.append(false)
    nulls.append(false)
    nulls.append(false)
    nulls.append(false)

    id_col: ColumnI64 = tabular.col_i64(ids_v, nulls)
    name_col: ColumnStr = tabular.col_str(names_v, nulls)
    score_col: ColumnF64 = tabular.col_f64(scores_v, nulls)
    active_col: ColumnBool = tabular.col_bool(active_v, nulls)
    # M50b: dept is now a ColumnCategorical so the frontend exercises
    # the new categorical JSON serializer.  Cells render as "eng" /
    # "sales" / "ops" rather than the M50a "null" placeholder.
    dept_col: ColumnCategorical = tabular.col_categorical(depts_v)

    names: List[str] = []
    names.append("id")
    names.append("name")
    names.append("score")
    names.append("active")
    names.append("dept")
    cols: List[Column] = []
    cols.append(id_col)
    cols.append(name_col)
    cols.append(score_col)
    cols.append(active_col)
    cols.append(dept_col)
    df: DataFrame = tabular.from_columns(names, cols)
    return df


fn main() -> i32:
    df: DataFrame = build_employees()
    println("tabular_serve_demo: built DataFrame with " + str(df.length()) + " rows.")
    println("Booting localhost HTTP server on 127.0.0.1:8765 ...")
    println("Open http://127.0.0.1:8765/ in a browser to view it.")
    println("Endpoints:")
    println("  GET  /                 — bundled HTML/JS frontend (M50b/M50c polish)")
    println("  GET  /api/schema       — names + dtypes + nrows + index info (M50c)")
    println("  GET  /api/rows         — paginated rows + parallel index array (M50c)")
    println("  GET  /api/cell         — single cell (row, col, df)")
    println("  GET  /api/csv          — full frame as CSV download (M50b)")
    println("  POST /api/filter       — one-column filter (eq/ne/gt/lt/ge/le)")
    println("  POST /api/filter_multi — composite AND/OR filter (M50b)")
    println("  POST /api/groupby      — group-by + agg; optional sort:true (M50c)")
    println("  POST /api/sort         — sortable column headers (M50b)")
    println("  POST /api/pivot        — interactive pivot table (M50c)")
    println("  POST /api/forget       — drop a derived df from registry (M50b)")
    println("Server timeout: 600 ms (demo mode).")
    rc: i32 = tabular.serve_with_timeout(df, 8765i32, 600i64)
    println("Server shut down with exit code: " + str(rc))
    return rc
