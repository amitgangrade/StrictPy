"""Binary tree exercising virtual dispatch (§14.4 vtables). `Node` is
`open` so it can be subclassed; `Leaf` and `Branch` are `final` per
StrictPy's closed-by-default policy (§1.3). Each subclass overrides
`sum`, and the call in `total` dispatches through the vtable."""

open class Node:
    open fn sum(self) -> i64:
        return 0

final class Leaf(Node):
    value: i64

    fn __init__(self, value: i64) -> None:
        self.value = value

    fn sum(self) -> i64:
        return self.value

final class Branch(Node):
    left: Node
    right: Node
    value: i64

    fn __init__(self, left: Node, right: Node, value: i64) -> None:
        self.left = left
        self.right = right
        self.value = value

    fn sum(self) -> i64:
        return self.value + self.left.sum() + self.right.sum()

fn main() -> i32:
    inner: Branch = Branch(Leaf(2), Leaf(3), 4)
    root: Branch = Branch(Leaf(1), inner, 5)
    total: i64 = root.sum()
    println("tree sum = " + str(total))
    return 0
