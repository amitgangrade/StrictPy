"""snake.spy — M55 reference game: a complete Snake in StrictPy.

A 20x20 cell grid (30 px per cell) with a 60 px top bar for score.
Window: 600 wide x 660 tall.

Controls:
  - Arrow keys: change direction.  180° reversal is rejected.
  - R         : restart after game over.
  - Escape    : quit.
  - The window's close button: quit.

Mechanics:
  - Snake starts 3 segments long, centred, stationary.  First arrow
    press starts movement.
  - Snake steps once every STEP_MS milliseconds (8 cells/second).
  - Eating food: grow by 1, +1 score, play eat.wav, spawn new food.
  - Wall collision OR self-collision: game over, play die.wav, overlay.

Architecture:
  - Single timer: loop body = drain events → step → render → sleep
    STEP_MS.  Everything runs at 8 Hz.  Input latency is ≤ STEP_MS,
    which for Snake is imperceptible.
  - The arrow keys set `dir_x` / `dir_y` directly with an inline 180°
    guard.  The earlier pending-direction indirection was simpler in
    principle but caused a Windows-only bug where the snake only
    moved on each key press (M55-v3 root cause).

Run it (from the repo root):
    cargo build --workspace --release
    ./target/release/spy examples/games/snake.spy
"""

import gfx
import time
import random
import sqlite3
from gfx import Window, Event, Font, Sound

# ── High-score persistence (M58) ────────────────────────────────────
#
# StrictPy v0.2 can't import a user `.spy` module, so the shared logic
# in examples/games/highscores.spy is inlined here.  See that file for
# the canonical reference + a runnable standalone demo.
final HS_DB: str = "strictpy_games.db"
final HS_GAME: str = "snake"
final HS_PLAYER: str = "PLAYER"

fn hs_ensure_schema(conn: Connection) -> None:
    conn.execute("CREATE TABLE IF NOT EXISTS scores (game TEXT, name TEXT, score INTEGER, ts INTEGER)")

fn hs_save_score(game: str, name: str, score: i64) -> None:
    conn: Connection = sqlite3.open(HS_DB)
    hs_ensure_schema(conn)
    params: List[str] = []
    params.append(game)
    params.append(name)
    params.append(str(score))
    params.append(str(time.now_ms()))
    conn.execute_params("INSERT INTO scores (game, name, score, ts) VALUES (?, ?, ?, ?)", params)
    conn.close()

fn hs_top_scores(game: str, n: i64) -> List[Tuple[str, i64]]:
    conn: Connection = sqlite3.open(HS_DB)
    hs_ensure_schema(conn)
    sql: str = "SELECT name, score FROM scores WHERE game = ? ORDER BY score DESC, ts ASC LIMIT " + str(n)
    qp: List[str] = []
    qp.append(game)
    cur: Cursor = conn.query_params(sql, qp)
    out: List[Tuple[str, i64]] = []
    rows: List[List[str]] = cur.fetchall()
    i: i32 = 0i32
    rn: i32 = i32(i64(len(rows)))
    while i < rn:
        row: List[str] = rows[i]
        out.append((row[0i32], parse_i64(row[1i32])))
        i = i + 1i32
    conn.close()
    return out

# ── Layout constants ─────────────────────────────────────────────────
final CELL: i32 = 30i32
final GRID_W: i32 = 20i32
final GRID_H: i32 = 20i32
final TOPBAR_H: i32 = 60i32
final WIN_W: i32 = 600i32              # CELL * GRID_W
final WIN_H: i32 = 660i32              # TOPBAR_H + CELL * GRID_H

# ── Timing ───────────────────────────────────────────────────────────
final STEP_MS: i64 = 125i64            # 8 snake steps per second

# ── Game state ───────────────────────────────────────────────────────

final class GameState:
    snake: List[Tuple[i32, i32]]       # head first
    dir_x: i32                         # -1 / 0 / 1
    dir_y: i32                         # -1 / 0 / 1
    food_x: i32
    food_y: i32
    score: i64
    game_over: bool
    score_saved: bool                  # M58: high score persisted once

    fn __init__(self) -> None:
        self.snake = []
        self.snake.append((10i32, 10i32))
        self.snake.append((9i32, 10i32))
        self.snake.append((8i32, 10i32))
        # Stationary spawn — first arrow press picks a direction.
        self.dir_x = 0i32
        self.dir_y = 0i32
        self.food_x = 0i32
        self.food_y = 0i32
        self.score = 0i64
        self.game_over = false
        self.score_saved = false

# ── Helpers ──────────────────────────────────────────────────────────

fn point_on_snake(snake: List[Tuple[i32, i32]], x: i32, y: i32) -> bool:
    i: i32 = 0i32
    n: i32 = i32(i64(len(snake)))
    while i < n:
        cell: Tuple[i32, i32] = snake[i]
        if cell.0 == x and cell.1 == y:
            return true
        i = i + 1i32
    return false

fn spawn_food(snake: List[Tuple[i32, i32]]) -> Tuple[i32, i32]:
    # Reject-sampling: try random cells until one isn't on the snake.
    while true:
        rx: i64 = random.randint(0i64, i64(GRID_W) - 1i64)
        ry: i64 = random.randint(0i64, i64(GRID_H) - 1i64)
        x: i32 = i32(rx)
        y: i32 = i32(ry)
        if not point_on_snake(snake, x, y):
            return (x, y)
    return (0i32, 0i32)                # unreachable; satisfies the typechecker

fn new_game() -> GameState:
    s: GameState = GameState()
    food: Tuple[i32, i32] = spawn_food(s.snake)
    s.food_x = food.0
    s.food_y = food.1
    return s

# ── Game logic step ─────────────────────────────────────────────────

fn step(state: GameState, eat: Sound, die: Sound) -> None:
    # Stationary snake?  No-op until the player picks a direction.
    if state.dir_x == 0i32 and state.dir_y == 0i32:
        return

    head: Tuple[i32, i32] = state.snake[0]
    new_x: i32 = head.0 + state.dir_x
    new_y: i32 = head.1 + state.dir_y

    # Wall collision.
    if new_x < 0i32 or new_x >= GRID_W or new_y < 0i32 or new_y >= GRID_H:
        state.game_over = true
        gfx.play_sound(die)
        return

    # Self collision.  Skip the tail (index len-1) because it WILL
    # move out of the way unless we're eating; the ate-check below
    # is consulted to decide which segments stay put.
    ate: bool = (new_x == state.food_x) and (new_y == state.food_y)
    check_end: i32 = i32(i64(len(state.snake)))
    if not ate:
        check_end = check_end - 1i32
    i: i32 = 0i32
    while i < check_end:
        seg: Tuple[i32, i32] = state.snake[i]
        if seg.0 == new_x and seg.1 == new_y:
            state.game_over = true
            gfx.play_sound(die)
            return
        i = i + 1i32

    # Build the new snake list.  Head goes first, then the existing
    # segments (minus the tail if we didn't eat).  List has no
    # insert(0, x) native so we rebuild.
    new_snake: List[Tuple[i32, i32]] = []
    new_snake.append((new_x, new_y))
    keep: i32 = i32(i64(len(state.snake)))
    if not ate:
        keep = keep - 1i32
    j: i32 = 0i32
    while j < keep:
        new_snake.append(state.snake[j])
        j = j + 1i32
    state.snake = new_snake

    if ate:
        state.score = state.score + 1i64
        food: Tuple[i32, i32] = spawn_food(state.snake)
        state.food_x = food.0
        state.food_y = food.1
        gfx.play_sound(eat)

# ── Event handling ──────────────────────────────────────────────────

fn handle_input(state: GameState, ev: Event) -> None:
    if ev.kind != "key_down":
        return
    # Arrow keys set direction directly.  Inline 180°-reversal guard:
    # reject the change if it would be the exact opposite of current
    # direction (e.g. snake moving Right cannot turn Left in place).
    # The stationary-snake case (dir = 0) passes every guard.
    if ev.key == "left" and state.dir_x != 1i32:
        state.dir_x = -1i32
        state.dir_y = 0i32
    elif ev.key == "right" and state.dir_x != -1i32:
        state.dir_x = 1i32
        state.dir_y = 0i32
    elif ev.key == "up" and state.dir_y != 1i32:
        state.dir_x = 0i32
        state.dir_y = -1i32
    elif ev.key == "down" and state.dir_y != -1i32:
        state.dir_x = 0i32
        state.dir_y = 1i32

# ── Rendering ───────────────────────────────────────────────────────

fn render(win: Window, font: Font, state: GameState) -> None:
    # Clear to a dark blue-grey playfield.
    gfx.clear(win, 30i32, 30i32, 40i32)

    # Top bar background.
    gfx.draw_rect(win, 0i32, 0i32, WIN_W, TOPBAR_H, 20i32, 22i32, 32i32, 255i32)
    gfx.draw_line(win, 0i32, TOPBAR_H, WIN_W, TOPBAR_H, 80i32, 80i32, 100i32, 255i32)

    # Score text in the top bar.
    score_msg: str = "Score: " + str(state.score)
    gfx.draw_text(win, font, score_msg, 16i32, 18i32, 240i32, 240i32, 240i32)

    # Food cell — red square with small inset.
    food_px: i32 = state.food_x * CELL
    food_py: i32 = TOPBAR_H + state.food_y * CELL
    gfx.draw_rect(win, food_px + 4i32, food_py + 4i32,
                  CELL - 8i32, CELL - 8i32,
                  220i32, 60i32, 60i32, 255i32)

    # Snake — head brighter than body.
    i: i32 = 0i32
    n: i32 = i32(i64(len(state.snake)))
    while i < n:
        cell: Tuple[i32, i32] = state.snake[i]
        sx: i32 = cell.0 * CELL
        sy: i32 = TOPBAR_H + cell.1 * CELL
        if i == 0i32:
            gfx.draw_rect(win, sx + 2i32, sy + 2i32, CELL - 4i32, CELL - 4i32,
                          140i32, 230i32, 140i32, 255i32)
        else:
            gfx.draw_rect(win, sx + 3i32, sy + 3i32, CELL - 6i32, CELL - 6i32,
                          80i32, 180i32, 80i32, 255i32)
        i = i + 1i32

    # Stationary "press to start" hint.  Shown when the snake hasn't
    # been given a direction yet (start of game or just after R).
    if (state.dir_x == 0i32) and (state.dir_y == 0i32) and (not state.game_over):
        hint: str = "Press an arrow key to start"
        hsz: Tuple[i32, i32] = gfx.text_size(font, hint)
        gfx.draw_rect(win,
                      (WIN_W - hsz.0) / 2i32 - 12i32,
                      TOPBAR_H + 16i32,
                      hsz.0 + 24i32,
                      hsz.1 + 12i32,
                      0i32, 0i32, 0i32, 160i32)
        gfx.draw_text(win, font, hint,
                      (WIN_W - hsz.0) / 2i32,
                      TOPBAR_H + 22i32,
                      240i32, 240i32, 160i32)

    # Game-over overlay.
    if state.game_over:
        gfx.draw_rect(win, 0i32, TOPBAR_H, WIN_W, WIN_H - TOPBAR_H,
                      0i32, 0i32, 0i32, 180i32)
        msg1: str = "GAME OVER"
        sz1: Tuple[i32, i32] = gfx.text_size(font, msg1)
        gfx.draw_text(win, font, msg1,
                      (WIN_W - sz1.0) / 2i32,
                      TOPBAR_H + (WIN_H - TOPBAR_H) / 2i32 - 40i32,
                      240i32, 100i32, 100i32)
        msg2: str = "Press R to restart, Escape to quit"
        sz2: Tuple[i32, i32] = gfx.text_size(font, msg2)
        gfx.draw_text(win, font, msg2,
                      (WIN_W - sz2.0) / 2i32,
                      TOPBAR_H + (WIN_H - TOPBAR_H) / 2i32 + 4i32,
                      220i32, 220i32, 220i32)

        # M58: top-5 high scores, read fresh from sqlite.
        top: List[Tuple[str, i64]] = hs_top_scores(HS_GAME, 5i64)
        hdr: str = "HIGH SCORES"
        szh: Tuple[i32, i32] = gfx.text_size(font, hdr)
        hy: i32 = TOPBAR_H + (WIN_H - TOPBAR_H) / 2i32 + 48i32
        gfx.draw_text(win, font, hdr,
                      (WIN_W - szh.0) / 2i32, hy,
                      255i32, 220i32, 120i32)
        ti: i32 = 0i32
        tn: i32 = i32(i64(len(top)))
        while ti < tn:
            te: Tuple[str, i64] = top[ti]
            line: str = str(ti + 1i32) + ". " + te.0 + "  " + str(te.1)
            szl: Tuple[i32, i32] = gfx.text_size(font, line)
            gfx.draw_text(win, font, line,
                          (WIN_W - szl.0) / 2i32,
                          hy + 28i32 + ti * 24i32,
                          220i32, 220i32, 220i32)
            ti = ti + 1i32

    gfx.present(win)

# ── Main ─────────────────────────────────────────────────────────────

fn main() -> i32:
    gfx.init()
    gfx.audio_init()
    random.seed(time.now_ms())

    win: Window = gfx.create_window("Snake — StrictPy M55", WIN_W, WIN_H)
    # M58: disable vsync so present() never blocks — Snake paces itself
    # with the fixed STEP_MS sleep below.
    gfx.set_vsync(win, false)
    font: Font = gfx.load_font("examples/games/snake/assets/font.ttf", 24i32)
    eat: Sound = gfx.load_sound("examples/games/snake/assets/eat.wav")
    die: Sound = gfx.load_sound("examples/games/snake/assets/die.wav")

    state: GameState = new_game()
    running: bool = true

    while running:
        # Drain all pending events.  Nullable narrowing only takes
        # effect inside `if X is not none:` blocks; we loop until
        # poll returns none using a sentinel boolean.
        draining: bool = true
        while draining:
            ev_opt: Event? = gfx.poll_event(win)
            if ev_opt is not none:
                if ev_opt.kind == "quit":
                    running = false
                elif ev_opt.kind == "key_down":
                    if ev_opt.key == "escape":
                        running = false
                    elif state.game_over and ev_opt.key == "r":
                        state = new_game()
                    else:
                        handle_input(state, ev_opt)
            else:
                draining = false

        if not running:
            break

        # M58: persist the final score exactly once when the snake dies.
        if state.game_over and not state.score_saved:
            hs_save_score(HS_GAME, HS_PLAYER, state.score)
            state.score_saved = true

        # Step game logic once per loop iteration.  The fixed
        # time.sleep_ms(STEP_MS) at the end of the loop paces the
        # whole thing at 8 Hz, so each iteration = one snake step.
        if not state.game_over:
            step(state, eat, die)

        # Render.
        render(win, font, state)

        # Pace the loop.  Constant sleep — input latency is bounded
        # by STEP_MS, which is imperceptible at 125 ms for Snake.
        time.sleep_ms(STEP_MS)

    gfx.free_font(font)
    gfx.free_sound(eat)
    gfx.free_sound(die)
    gfx.close_window(win)
    return 0
