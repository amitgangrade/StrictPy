"""sum_args.spy — parse `sys.argv[1..]` as i64, sum, print result (M19).

Exercises three M19 surfaces in one program:
  * `import sys` — module-attribute access to `sys.argv`.
  * `from sys import exit` — bare-name access to a stdlib function.
  * `sys.exit(1)` — non-catchable termination.  In particular, calling
    `exit(1)` from inside a `try: ... except Exception:` MUST escape
    the handler (Python: SystemExit is not an Exception).

Each argv element is parsed with `parse_i64`, which raises a
`ValueError` on malformed input; we catch that, print a useful
diagnostic, and call `exit(1)`.  No args → print 0 and exit cleanly.

Tests:
  * `compiler/tests/sum_args_runs.rs` — subprocess assertions.
"""

import sys
from sys import exit

fn parse_or_die(arg: str) -> i64:
    """Parse one argv element; on failure, abort with a diagnostic.

    The try/except is mostly here to demonstrate that an explicit
    `exit(1)` from inside the handler still escapes, even when the
    handler matched `Exception`. (Pre-M19 we had no escape hatch: the
    handler caught everything and the program had to set a flag and
    `return` an error code from `main`.)
    """
    try:
        return parse_i64(arg)
    except Exception as e:
        println("sum_args: cannot parse " + arg + ": " + e.message)
        exit(1)
        return 0  # unreachable; the typechecker still wants a return value


fn main() -> i32:
    total: i64 = 0
    # argv[0] is the program path; skip it.
    n: i64 = i64(len(sys.argv))
    i: i64 = 1
    while i < n:
        total = total + parse_or_die(sys.argv[i])
        i = i + 1
    println("sum = " + str(total))
    return 0
