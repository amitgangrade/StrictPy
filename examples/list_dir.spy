"""list_dir.spy — print every entry in the current working directory (M20a).

Exercises:
  * `import os` — the M20a `os` module, registered alongside `sys` in
    `seed_stdlib_modules`.
  * `os.listdir(".")` — `std::fs::read_dir`-backed native, returns a
    `List[str]` of bare entry names (no trailing slashes, no full paths).
  * `os.getcwd()` — banner line so the test can sanity-check the listing
    came from the project root.

`spy.exe` runs from the project root in the subprocess test, so the
listing must contain known top-level files (`Cargo.toml`, `examples`).

Tests:
  * `compiler/tests/list_dir_runs.rs` — subprocess assertion.
"""

import os

fn main() -> i32:
    println("cwd: " + os.getcwd())
    entries: List[str] = os.listdir(".")
    n: i64 = i64(len(entries))
    i: i64 = 0
    while i < n:
        println(entries[i])
        i = i + 1
    return 0
