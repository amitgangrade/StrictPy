"""_probe_dict_in_types.spy — narrow what `in` does on dicts.

Tests:
* Python semantics: `k in d` should test for key membership.
* Maybe StrictPy implements `v in d` (value membership)? unlikely but test.

NOTE: non-`str` dict keys (`Dict[i64, V]`) are now a hard compile error
(E2072, Wave-1 Lane D) — they used to segfault at subscript. The former
`Dict[i64, i64]` section of this probe was removed; the negative test
`dict_i64_key_rejected` in conformance_negative.rs covers that case.
"""


fn main() -> i32:
    # Dict[str, i64] — does "in" check key or value membership?
    d: Dict[str, i64] = {}
    d["alpha"] = 42i64
    d["beta"] = 7i64

    # Key membership
    if "alpha" in d:
        println("\"alpha\" in d: true")
    else:
        println("\"alpha\" in d: false")

    # Non-member key
    if "gamma" in d:
        println("\"gamma\" in d: true  (UNEXPECTED)")
    else:
        println("\"gamma\" in d: false")

    # Dict[str, str]
    ds: Dict[str, str] = {}
    ds["k1"] = "v1"
    if "k1" in ds:
        println("k1 in ds: true")
    else:
        println("k1 in ds: false")
    # Try value-membership behaviour:
    if "v1" in ds:
        println("v1 in ds: true (would mean value-membership)")
    else:
        println("v1 in ds: false")

    return 0
