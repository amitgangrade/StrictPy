# core_quicksort: recursive in-place quicksort of an LCG-generated List[i64].

fn quicksort(a: List[i64], lo: i64, hi: i64) -> None:
    if lo < hi:
        mid: i64 = (lo + hi) // 2
        tmp: i64 = a[mid]
        a[mid] = a[hi]
        a[hi] = tmp
        pivot: i64 = a[hi]
        i: i64 = lo
        for j: i64 in range(lo, hi):
            if a[j] < pivot:
                t: i64 = a[i]
                a[i] = a[j]
                a[j] = t
                i = i + 1
        t2: i64 = a[i]
        a[i] = a[hi]
        a[hi] = t2
        quicksort(a, lo, i - 1)
        quicksort(a, i + 1, hi)

fn run() -> i32:
    n: i64 = 60000
    a: List[i64] = []
    seed: i64 = 1234567
    for k: i64 in range(n):
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.append(seed % 1000000)
    quicksort(a, 0, n - 1)
    checksum: i64 = 0
    for p: i64 in range(0, n, 600):
        checksum = (checksum * 31 + a[p]) % 1000000007
    println("quicksort_checksum=" + str(checksum))
    println("quicksort_min=" + str(a[0]))
    println("quicksort_max=" + str(a[n - 1]))
    return 0

fn main() -> i32:
    return run()
