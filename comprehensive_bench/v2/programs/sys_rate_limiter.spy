"""Token-bucket rate limiter simulation over 500k synthetic events with
integer timestamps; print allowed/rejected counts."""

fn run() -> i32:
    n: i64 = 500000
    capacity: i64 = 100
    refill_per_tick: i64 = 2
    tokens: i64 = capacity
    last_ts: i64 = 0
    state: i64 = 555555555
    allowed: i64 = 0
    rejected: i64 = 0
    clock: i64 = 0

    i: i64 = 0
    while i < n:
        state = (state * 1103515245 + 12345) % 2147483648
        clock = clock + state % 3          # 0-2 ticks between events
        cost: i64 = 1i64 + state % 4       # request cost 1-4 tokens

        if clock > last_ts:
            tokens = tokens + (clock - last_ts) * refill_per_tick
            if tokens > capacity:
                tokens = capacity
            last_ts = clock

        if tokens >= cost:
            tokens = tokens - cost
            allowed = allowed + 1
        else:
            rejected = rejected + 1
        i = i + 1

    println("allowed=" + str(allowed))
    println("rejected=" + str(rejected))
    println("final_tokens=" + str(tokens))
    println("final_clock=" + str(clock))
    return 0

fn main() -> i32:
    return run()
