# core_calls: small-function call overhead — tiny fns called in a hot loop.

fn add(a: i64, b: i64) -> i64:
    return a + b

fn mul(a: i64, b: i64) -> i64:
    return a * b

fn clamp(x: i64, lo: i64, hi: i64) -> i64:
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

fn run() -> i32:
    acc: i64 = 0
    for i: i64 in range(1000000):
        s: i64 = add(i % 97, i % 31)
        p: i64 = mul(s, 3)
        c: i64 = clamp(p - 150, 0, 200)
        acc = acc + c
    println("calls_acc=" + str(acc))
    return 0

fn main() -> i32:
    return run()
