# str_http_parse: realistic HTTP/1.1 request parser using native string
# methods: split request-line/headers/body, lowercase header names, extract
# Content-Length. Parse a fixed request N times; print aggregate counters.
# NOTE: no native str.lower() in this spy build — manual ASCII helper used
# for header-name lowercasing (recorded in notes_str.md).

fn ascii_lower(s: str) -> str:
    out: str = ""
    n: i64 = i64(len(s))
    i: i64 = 0
    while i < n:
        c: char = s[i]
        if c >= 'A' and c <= 'Z':
            out = out + str(char(i32(c) + 32i32))
        else:
            out = out + str(c)
        i = i + 1
    return out

fn parse_one(req: str) -> i64:
    sep: i64 = req.find("\r\n\r\n")
    if sep < 0:
        return 0
    head: str = req.slice(0, sep)
    body: str = req.slice(sep + 4, i64(len(req)))
    lines: List[str] = head.split("\r\n")
    req_line: str = lines[0]
    parts: List[str] = req_line.split(" ")
    method: str = parts[0]
    path: str = parts[1]

    score: i64 = 0
    if method == "GET":
        score = score + 1
    if path.contains("?"):
        score = score + 1

    content_length: i64 = -1
    nlines: i64 = i64(len(lines))
    i: i64 = 1
    while i < nlines:
        line: str = lines[i]
        ci: i64 = line.find(":")
        if ci >= 0:
            hname: str = ascii_lower(line.slice(0, ci))
            hval: str = line.slice(ci + 1, i64(len(line))).strip()
            score = score + 10
            if hname == "content-length":
                content_length = parse_i64(hval)
            if hname.startswith("x-"):
                score = score + 1
        i = i + 1
    if content_length == i64(len(body)):
        score = score + 100
    return score + content_length

fn run() -> i32:
    req: str = "GET /api/v2/items?page=3 HTTP/1.1\r\n" +
        "Host: example.com:8080\r\n" +
        "User-Agent: bench/1.0\r\n" +
        "Accept: application/json\r\n" +
        "X-Request-Id: abc-123-def\r\n" +
        "Content-Type: application/json\r\n" +
        "Content-Length: 26\r\n" +
        "\r\n" +
        "{\"query\":\"items\",\"page\":3}"
    n: i64 = 12000
    total: i64 = 0
    i: i64 = 0
    while i < n:
        total = total + parse_one(req)
        i = i + 1
    println("total=" + str(total))
    println("per_req=" + str(total / n))
    return 0

fn main() -> i32:
    return run()
