# core_branchy: branch-heavy loop — nested if/elif chains plus and/or
# short-circuit logic over an LCG stream; counts bucket hits.

fn run() -> i32:
    seed: i64 = 42
    b0: i64 = 0
    b1: i64 = 0
    b2: i64 = 0
    b3: i64 = 0
    b4: i64 = 0
    for i: i64 in range(800000):
        seed = (seed * 1103515245 + 12345) % 2147483648
        v: i64 = seed % 1000
        if v < 100 and seed % 7 == 0:
            b0 = b0 + 1
        elif v < 300 or v > 950:
            b1 = b1 + 1
        elif v % 2 == 0 and (v % 3 == 0 or v % 5 == 0):
            b2 = b2 + 1
        elif v < 600:
            b3 = b3 + 1
        else:
            b4 = b4 + 1
    println("branchy_b0=" + str(b0))
    println("branchy_b1=" + str(b1))
    println("branchy_b2=" + str(b2))
    println("branchy_b3=" + str(b3))
    println("branchy_b4=" + str(b4))
    return 0

fn main() -> i32:
    return run()
