# str_join_build: build a comma-separated string of 100k ints, repeated.
# Idiomatic StrictPy now uses the native sep.join(List[str]) (added in the
# strings-round-2 work), matching Python's ",".join(...). Print len + a slice
# sample.

fn build(n: i64) -> str:
    parts: List[str] = []
    i: i64 = 0
    while i < n:
        parts.append(str(i))
        i = i + 1
    return ",".join(parts)

fn run() -> i32:
    n: i64 = 100000
    reps: i64 = 20
    total: i64 = 0
    sample: str = ""
    r: i64 = 0
    while r < reps:
        s: str = build(n)
        total = total + i64(len(s))
        sample = s.slice(100, 120)
        r = r + 1
    println("total_len=" + str(total))
    println("one_len=" + str(total / reps))
    println("sample=" + sample)
    return 0

fn main() -> i32:
    return run()
