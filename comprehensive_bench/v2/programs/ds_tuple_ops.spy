# ds_tuple_ops: create/destructure tuples in a hot loop (divmod-style),
# tuple as multi-return.

fn split10(x: i64) -> Tuple[i64, i64]:
    return (x // 10, x % 10)

fn run() -> i32:
    n: i64 = 1000000
    acc_q: i64 = 0
    acc_r: i64 = 0
    acc_swap: i64 = 0
    i: i64 = 0
    while i < n:
        q, r = split10(i * 13 % 100000)
        acc_q = acc_q + q
        acc_r = acc_r + r
        p: Tuple[i64, i64] = (r, q)
        acc_swap = acc_swap + p.1 % 3
        i = i + 1
    println("acc_q=" + str(acc_q))
    println("acc_r=" + str(acc_r))
    println("acc_swap=" + str(acc_swap))
    return 0

fn main() -> i32:
    return run()
