# core_recursion_ack: Ackermann function, deep recursion.

fn ack(m: i64, n: i64) -> i64:
    if m == 0:
        return n + 1
    if n == 0:
        return ack(m - 1, 1)
    return ack(m - 1, ack(m, n - 1))

fn run() -> i32:
    result: i64 = ack(3, 6)
    println("ack=" + str(result))
    return 0

fn main() -> i32:
    return run()
