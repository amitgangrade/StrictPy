"""Cache-server pattern: bounded Dict[str, i64] cache with two-generation
(segmented) eviction, 300k mixed get/put ops from an LCG key stream; print
hit/miss/rotation counts.

Design note: StrictPy currently has no way to remove a Dict key (`del d[k]`
parses but lowers to a no-op — see ../notes_sys.md), so instead of a classic
eviction list this uses the segment trick: two generations `cur` and `prev`;
when `cur` fills to cap/2, `prev` is discarded wholesale and `cur` becomes
`prev`. Memory stays bounded at ~cap entries and old keys age out."""

fn fresh() -> Dict[str, i64]:
    d: Dict[str, i64] = {}
    return d

fn run() -> i32:
    n: i64 = 300000
    half_cap: i64 = 2048
    cur: Dict[str, i64] = fresh()
    prev: Dict[str, i64] = fresh()
    state: i64 = 987654321
    hits: i64 = 0
    misses: i64 = 0
    rotations: i64 = 0

    i: i64 = 0
    while i < n:
        state = (state * 1103515245 + 12345) % 2147483648
        key: str = "k" + str(state % 30000)
        op: i64 = state % 10

        if op < 7:
            # get
            v: i64? = cur.get(key)
            if v is not none:
                hits = hits + 1
            else:
                w: i64? = prev.get(key)
                if w is not none:
                    hits = hits + 1
                    cur[key] = w        # promote into the live generation
                else:
                    misses = misses + 1
                    cur[key] = i        # miss-fill
        else:
            # put (insert or overwrite)
            cur[key] = i

        # Rotate generations once the live one fills up.
        if len(cur) >= half_cap:
            prev = cur
            cur = fresh()
            rotations = rotations + 1
        i = i + 1

    println("hits=" + str(hits))
    println("misses=" + str(misses))
    println("rotations=" + str(rotations))
    println("resident=" + str(len(cur) + len(prev)))
    return 0

fn main() -> i32:
    return run()
