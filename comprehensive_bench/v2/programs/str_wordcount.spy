# str_wordcount: word frequency over a synthetic ~1MB text (deterministic
# generated words), split on space, count in dict, print top-10 sorted by
# count desc then word asc (identical tie-break both sides). Hot loops live
# in kernel functions (StrictPy optimizations are per-function).

fn build_text(nwords: i64) -> str:
    text: str = ""
    i: i64 = 0
    while i < nwords:
        idx: i64 = (i * i + 17i64 * i) % 1200
        w: str = "w" + str(idx)
        if i == 0:
            text = text + w
        else:
            piece: str = " " + w
            text = text + piece
        i = i + 1
    return text

fn count_words(text: str, reps: i64) -> Dict[str, i64]:
    counts: Dict[str, i64] = {}
    r: i64 = 0
    while r < reps:
        counts = {}
        words: List[str] = text.split(" ")
        for w: str in words:
            if counts.has(w):
                counts[w] = counts[w] + 1
            else:
                counts[w] = 1
        r = r + 1
    return counts

fn run() -> i32:
    nwords: i64 = 150000
    text: str = build_text(nwords)
    counts: Dict[str, i64] = count_words(text, 4)

    # top-10: count desc, word asc — via composite sortable key
    entries: List[str] = []
    for k: str in counts.keys():
        c: i64 = counts[k]
        entries.append(str(9999999999i64 - c) + ":" + k)
    entries.sort()
    j: i64 = 0
    while j < 10:
        e: str = entries[j]
        ci: i64 = e.find(":")
        cnum: i64 = 9999999999i64 - parse_i64(e.slice(0, ci))
        w: str = e.slice(ci + 1, i64(len(e)))
        println("top" + str(j) + "=" + w + ":" + str(cnum))
        j = j + 1
    println("unique=" + str(len(counts)))
    println("text_len=" + str(len(text)))
    return 0

fn main() -> i32:
    return run()
