/target
*.spyc
*.spya
*.swp
.DS_Store
.vscode/
.idea/

# Local Claude Code state — not part of the project.
.claude/

# Auto-generated Python bytecode in bench/generated/.
__pycache__/
*.pyc

# Bench harness regenerates these on every run (.spy, .py, .spyc, plus
# input corpora .csv/.json/.txt). Not source; tracked snapshots live in
# bench/history/*.json and the rendered .md reports.
/bench/generated/

# Transient artifacts produced by examples/safe_open.spy when the test
# runs the example from the compiler crate's cwd. The example creates
# these as input data; they're not part of the source tree.
/compiler/safe_open_a.txt
/compiler/safe_open_c.txt

# Uploaded files from examples/webserver/todo_app.spy /api/upload route.
# The .gitkeep file keeps the directory present in source control; any
# actual uploads are test artifacts.
/examples/webserver/uploads/*
!/examples/webserver/uploads/.gitkeep

